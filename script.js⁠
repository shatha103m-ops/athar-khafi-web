.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(12, 12, 15, 0.96);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.header-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64px;
}

.brand {
  color: var(--gold);
  text-decoration: none;
  font-weight: 700;
  font-size: 1.2rem;
}

.main-nav {
  display: flex;
  gap: 1.25rem;
}

.main-nav a {
  color: var(--text);
  text-decoration: none;
  font-size: 0.95rem;
}

.main-nav a:hover {
  color: var(--gold);
}

.menu-toggle {
  display: none;
  background: var(--surface);
  color: var(--gold);
  border: 1px solid var(--gold);
  border-radius: 8px;
  padding: 0.35rem 0.7rem;
  font-size: 1.15rem;
  line-height: 1;
  cursor: pointer;
}

section[id] {
  scroll-margin-top: 76px;
}

@media (max-width: 700px) {
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .main-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 101;
    background: #15151b;
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 5%;
  }

  .main-nav.open {
    display: flex;
  }

  .main-nav a {
    padding: 0.65rem 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 1rem;
  }

  .main-nav a:last-child {
    border-bottom: none;
  }
}
